generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  SAVED
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
  ARCHIVED
}

enum RemoteType {
  REMOTE
  HYBRID
  ONSITE
  UNKNOWN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
  UNKNOWN
}

enum SeniorityLabel {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
  UNKNOWN
}

enum WorkStyleLabel {
  REMOTE
  HYBRID
  ONSITE
  UNKNOWN
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String          @unique
  emailVerified  DateTime?
  passwordHash   String?
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accounts       Account[]
  sessions       Session[]
  savedJobs      SavedJob[]
  reminders      Reminder[]
  searchHistory  SearchHistory[]
}

model SavedJob {
  id                 String           @id @default(cuid())
  userId             String
  externalJobId      String?
  title              String
  company            String
  location           String
  remoteType         RemoteType       @default(UNKNOWN)
  employmentType     EmploymentType   @default(UNKNOWN)
  salaryEstimate     String?
  source             String
  sourceUrl          String
  companyLogo        String?
  datePosted         DateTime?
  description        String           @db.Text
  aiSummary          String?          @db.Text
  extractedSkills    String[]         @default([])
  seniority          SeniorityLabel   @default(UNKNOWN)
  workStyle          WorkStyleLabel   @default(UNKNOWN)
  status             JobStatus        @default(SAVED)
  applicationDate    DateTime?
  followUpDate       DateTime?
  expectedSalary     Int?
  resumeVersion      String?
  coverLetterVersion String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes              JobNote[]
  reminders          Reminder[]

  @@unique([userId, externalJobId])
  @@unique([userId, sourceUrl])
  @@index([userId, status])
  @@index([userId, company])
  @@index([userId, followUpDate])
}

model JobNote {
  id         String   @id @default(cuid())
  savedJobId String
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  savedJob   SavedJob @relation(fields: [savedJobId], references: [id], onDelete: Cascade)

  @@index([savedJobId, createdAt])
}

model Reminder {
  id         String   @id @default(cuid())
  userId     String
  savedJobId String
  title      String
  dueDate    DateTime
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedJob   SavedJob @relation(fields: [savedJobId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
  @@index([savedJobId])
}

model SearchHistory {
  id             String   @id @default(cuid())
  userId         String
  query          String
  location       String?
  remote         String?
  employmentType String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
